# ── Discord (required) ──
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Optional: register slash commands to ONE server (instant). Leave empty for global (up to ~1h to appear).
GUILD_ID=

# ── Data providers ──
ODDS_API_KEY=your-the-odds-api-key
# TheSportsDB free test key is 123; replace if you have your own
THESPORTSDB_KEY=123

# ── Safety / tuning (all optional) ──
# Caps can only be LOWERED here; the hard maximums (12/day, 380/month) are constants in cache/cacheManager.js
MAX_DAILY_API_CALLS=12
MAX_MONTHLY_API_CALLS=380
# Per-user cooldown on every slash command (seconds). Set 0 while testing.
COOLDOWN_SECONDS=300
# 0-1: weight on the model vs. the de-vigged market when computing edge (lower = more conservative)
MODEL_WEIGHT=0.35
# Persist quota counters across redeploys: add a Railway Volume mounted at /data, then set:
# COUNTER_FILE=/data/usage.json
